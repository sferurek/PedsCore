# Public build-time configuration. VITE_* values are embedded in the browser.
VITE_ANALYTICS_PROVIDER=vercel
VITE_PUBLIC_STATS_ENABLED=true
VITE_PUBLIC_STATS_ENDPOINT=/api/analytics/countries

# Server-only Vercel Web Analytics configuration.
# Keep the real access token in Vercel and mark it sensitive.
ANALYTICS_STATS_PROVIDER=vercel
ANALYTICS_PUBLIC_STATS_ENABLED=true
VERCEL_ACCESS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_TEAM_SLUG=
VERCEL_ANALYTICS_COUNTRY_SINCE=
ANALYTICS_COUNTRY_MIN_THRESHOLD=5
ANALYTICS_COUNTRY_CACHE_SECONDS=3600
