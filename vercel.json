{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/PedsCore",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/PedsCore/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/es/tools/modified-finnegan",
      "destination": "/es/tools/fnass-21",
      "permanent": true
    },
    {
      "source": "/en/tools/modified-finnegan",
      "destination": "/en/tools/fnass-21",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/tools/:id",
      "destination": "/api/v1/tools?id=:id"
    },
    {
      "source": "/api/analytics/countries",
      "destination": "/api/analytics/countries.js"
    },
    {
      "source": "/api/v1/tools",
      "destination": "/api/v1/tools.js"
    },
    {
      "source": "/api/v1/tools/:id",
      "destination": "/api/v1/tools.js?id=:id"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "seo/gorelick-intent-20261105": false,
      "fix/p0-seo-topic-parity-20261105": false,
      "sprint/p2-build-costs-20261105": false,
      "sprint/p1-clinical-ux-20261105": false,
      "fix/pim3-category-validation-20261105": false,
      "docs/sprint-international-seo-20261105": false,
      "release/november-sprint-20261105": false,
      "fix/vite-security-patch-20261105": false,
      "fix/compatible-security-updates-20261105": false,
      "fix/popular-tools-analytics-20261105": false,
      "seo/current-audit-followup-20261105": false,
      "sprint/night-quality-20261107": false,
      "fix/discrete-score-inputs-20261107": false,
      "fix/search-command-accessibility-20261107": false,
      "audit/gcs-input-contract-local-20261107": false,
      "audit/night-local-candidate-20261107": false
    }
  }
}
